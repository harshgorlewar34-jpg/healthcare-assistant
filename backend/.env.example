PORT=5000

# -------------------------------------------------------
# DATABASE — MongoDB Atlas (required for persistent data)
# Get a free cluster at: https://cloud.mongodb.com
# If not set, the app uses an in-memory fallback (demo only)
# -------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/medibot?retryWrites=true&w=majority

# -------------------------------------------------------
# JWT Secret — change this to a long random string
# -------------------------------------------------------
JWT_SECRET=medibot_super_secure_jwt_secret_change_me_in_production

# -------------------------------------------------------
# AI Provider: "gemini" | "openai" | leave blank for rule-based engine
# -------------------------------------------------------
AI_PROVIDER=gemini

# Google Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# -------------------------------------------------------
# CORS — set to your deployed Vercel frontend URL
# e.g. https://medibot-frontend.vercel.app
# -------------------------------------------------------
FRONTEND_URL=https://your-frontend.vercel.app
